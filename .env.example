# GEMINI_API_KEY: Required for Gemini AI API calls (including hosted Gemma 4 models).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="your_gemini_api_key_here"

# GEMMA_MODEL: Hosted Gemma 4 model ID via the Gemini API.
# Supported Gemma 4 IDs: gemma-4-31b-it, gemma-4-26b-a4b-it
GEMMA_MODEL="gemma-4-26b-a4b-it"

# PORT: Backend Express & Vite server port.
PORT="3000"

# OPTIONAL — External Image Search Provider (Section B: Discover More Designs)
# Configure Google Programmable Search Engine credentials for live Google Image Search:
GOOGLE_CSE_API_KEY=""
GOOGLE_CSE_CX=""

# INSPIRATION_PROVIDER: "auto" (default: uses google-cse if keys set, else wikimedia-commons with sample-fallback),
# or force "google-cse", "wikimedia-commons", or "sample-fallback".
INSPIRATION_PROVIDER="auto"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"
